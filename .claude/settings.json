{
	"permissions": {
		"allow": ["Bash"],
		"deny": ["Bash(curl)", "Bash(curl *)"]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
						"timeout": 30
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome-format.sh",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(supabase *)",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/migration-followup.sh",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-failure-hints.sh",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-stop.sh",
						"timeout": 180
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comment-style.sh",
						"timeout": 5
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume|clear",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-brief.sh",
						"timeout": 15
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-log.sh",
						"timeout": 5
					}
				]
			}
		]
	}
}
