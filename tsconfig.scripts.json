{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"paths": {
			"@/scripts/*": ["./scripts/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["scripts/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", ".next"]
}
