# Copy to .env.local and fill in. Placeholders only — never put real values here.
#
#   cp env.example .env.local
#
# Named without a leading dot because a git hook blocks writing any `.env*`
# path. The full reference, including the operator scripts, the test suite and
# the Cloudflare worker, is in docs/guides/vercel-env.md.
#
# A NEXT_PUBLIC_ prefix means the value ships to the browser. Never give one to
# a key that grants more than a visitor already has.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# clerk | supabase. next.config.ts derives NEXT_PUBLIC_AUTH_PROVIDER from this,
# so set only this one.
AUTH_PROVIDER=clerk

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side auth only: the OAuth callback, the email confirm interstitial and
# the middleware session refresh. Bypasses RLS — never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Captcha widget. Must be set AND deployed before captcha is enabled in
# Supabase, or every password sign-in, sign-up and reset is rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Only while AUTH_PROVIDER=clerk. Removed at Phase 5.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Database — both are pooler URLs on port 6543
# ---------------------------------------------------------------------------
# User and visitor traffic. After migration M08 this is the `app_rls` login,
# which owns nothing and can only switch into the app roles.
DB_CONNECTION_STRING=postgresql://...

# Webhooks, provisioning, e2e cleanup, drizzle-kit pull. Stays on `postgres`,
# which bypasses RLS. Before M08 it may be the same URL; after M08 they differ.
DB_ADMIN_CONNECTION_STRING=postgresql://...

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keyspace separation: prod | test | ci | dev-<your-name>.
# UNSET FALLS BACK TO "dev", so leaving it empty shares a keyspace with every
# other developer.
REDIS_KEY_PREFIX=dev-local

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# QR code target. Falls back to https://quicktalog.com — the wrong TLD — so set
# it explicitly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared with the Cloudflare worker; authenticates /api/revalidate. Must be
# byte-identical on both sides.
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
PADDLE_API_KEY=
PADDLE_CUSTOM_DATA_SECRET=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ---------------------------------------------------------------------------
# Email — the app's own transactional mail (welcome, cancellation, contact).
# Separate from the SMTP credentials Supabase Auth uses for its own emails.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Runtime switches — the env-var fallback used when no Global Config store is
# connected (local, CI, previews). With a store connected these are ignored.
# See the runtime-switches table in docs/guides/vercel-env.md.
# ---------------------------------------------------------------------------
# MAINTENANCE_MODE=1
# MAINTENANCE_BYPASS_TOKEN=          # 32 characters minimum, or it fails closed
# BANNER_MESSAGE=
# CLERK_FROZEN=1                     # the T-3 "account changes are paused" notice

# ---------------------------------------------------------------------------
# Analytics and monitoring — all optional, inert when unset
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
GTM_ID=
NEXT_PUBLIC_LOGO_DEV_TOKEN=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_DISABLE_LOGGING=false

# ---------------------------------------------------------------------------
# Do NOT set these by hand: the platform provides them.
# NODE_ENV, VERCEL_ENV, VERCEL_URL, NEXT_RUNTIME, CI, BASE_PATH
#
# NODE_ENV in particular — anything other than "production" on a deployed
# environment disables Sentry and stops session cookies being marked Secure.
# ---------------------------------------------------------------------------
