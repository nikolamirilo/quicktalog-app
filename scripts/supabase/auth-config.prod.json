{
	"site_url": "https://www.quicktalog.app",
	"uri_allow_list": "https://www.quicktalog.app/**",
	"disable_signup": true,
	"external_anonymous_users_enabled": false,
	"mailer_autoconfirm": false,
	"mailer_secure_email_change_enabled": true,
	"security_update_password_require_reauthentication": true,
	"password_min_length": 8,
	"password_required_characters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ:0123456789",
	"jwt_exp": 3600,
	"refresh_token_rotation_enabled": true,
	"security_refresh_token_reuse_interval": 10,
	"security_sb_forwarded_for_enabled": true,
	"security_captcha_enabled": true,
	"security_captcha_provider": "turnstile",
	"external_google_enabled": true,
	"rate_limit_email_sent": 60,
	"smtp_host": "smtp.resend.com",
	"smtp_port": "465",
	"smtp_user": "resend",
	"smtp_sender_name": "Quicktalog",
	"smtp_admin_email": "no-reply@auth.quicktalog.app",
	"mailer_templates_confirmation_content": null
}
